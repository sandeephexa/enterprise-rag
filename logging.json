{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"plain": {"format": "%(message)s"}},
  "handlers": {"console": {"class": "logging.StreamHandler", "formatter": "plain", "stream": "ext://sys.stdout"}},
  "loggers": {"rag.audit": {"handlers": ["console"], "level": "INFO", "propagate": false}, "httpx": {"level": "WARNING"}, "uvicorn.access": {"handlers": [], "propagate": false}},
  "root": {"handlers": ["console"], "level": "WARNING"}
}
