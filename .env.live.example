# Replace EVERY CHANGE_ME value. Inject secrets through your deployment secret manager.
RAG_MODE=live
RAG_DATABASE_PATH=data/live.sqlite3
RAG_ACCESS_KEYS=[{"token":"CHANGE_ME_TO_RANDOM_32_BYTE_TOKEN","tenant":"acme","groups":["staff"],"roles":["query","ingest","review"]}]
# Prices below are illustrative placeholders, NOT a vendor quote. Replace with your rates.
# Add a second endpoint object for a separately provisioned fallback.
RAG_ENDPOINTS=[{"name":"primary","base_url":"https://api.openai.com/v1","api_key":"CHANGE_ME","model":"CHANGE_ME","input_usd_per_million":1.0,"output_usd_per_million":4.0}]
# These immutable revisions are also the application defaults; review before release.
RAG_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RAG_NLI_REVISION=fa2804872c3b4bd748f38c0185cc85775361e735
RAG_LOCAL_MODELS_ONLY=false
RAG_INFERENCE_DEVICE=cpu
RAG_CHUNK_STRATEGY=paragraph
RAG_CHUNK_CHARS=700
RAG_RERANK_THRESHOLD=0.4
RAG_ENTAILMENT_THRESHOLD=0.85
RAG_LATENCY_BUDGET_S=20
RAG_MAX_COST_USD=0.10

# Direct document uploads (separate from the JSON request body limit)
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_EXTRACTED_CHARS=200000
RAG_UPLOAD_PARSE_TIMEOUT_S=30
RAG_MAX_CONCURRENT_UPLOADS=2

# Latency: search first; expand only when no usable context was selected.
RAG_REWRITE_MODE=fallback
RAG_NLI_BATCH_SIZE=4
# Verified-answer cache; set TTL to 0 to disable. Supported index mutations invalidate it.
RAG_ANSWER_CACHE_TTL_S=60
RAG_ANSWER_CACHE_MAX_ENTRIES=128

# Fast structured generation: references to exact source spans, resolved on the server.
RAG_GENERATION_EVIDENCE_MODE=spans
RAG_COMPACT_EVIDENCE_IDS=true
# Provider/model dependent. Enable only after verifying support and answer quality:
# RAG_GENERATION_REASONING_EFFORT=none

# Document Q&A returns semantically selected, exact source sentences.
# Use synthesis explicitly when generated paraphrases are required.
RAG_ANSWER_STYLE=extractive
