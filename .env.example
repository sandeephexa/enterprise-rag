# OFFLINE DEMO ONLY. Bind to loopback. This is a public sample credential.
RAG_MODE=demo
RAG_DATABASE_PATH=data/demo.sqlite3
RAG_ACCESS_KEYS=[{"token":"demo-only-change-before-sharing-12345","tenant":"acme","groups":["staff"],"roles":["query","ingest","review"]}]
RAG_LATENCY_BUDGET_S=20
RAG_MAX_COST_USD=0.10
# RAG_OTLP_ENDPOINT=http://localhost:4318

# Direct document uploads (separate from the JSON request body limit)
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_EXTRACTED_CHARS=200000
RAG_UPLOAD_PARSE_TIMEOUT_S=30
RAG_MAX_CONCURRENT_UPLOADS=2

# Latency: search first; expand only when no usable context was selected.
RAG_REWRITE_MODE=fallback
RAG_NLI_BATCH_SIZE=4
# Verified-answer cache; set TTL to 0 to disable. Supported index mutations invalidate it.
RAG_ANSWER_CACHE_TTL_S=60
RAG_ANSWER_CACHE_MAX_ENTRIES=128

# Fast structured generation: references to exact source spans, resolved on the server.
RAG_GENERATION_EVIDENCE_MODE=spans
RAG_COMPACT_EVIDENCE_IDS=true
# Provider/model dependent. Enable only after verifying support and answer quality:
# RAG_GENERATION_REASONING_EFFORT=none

# Document Q&A returns semantically selected, exact source sentences.
# Use synthesis explicitly when generated paraphrases are required.
RAG_ANSWER_STYLE=extractive
